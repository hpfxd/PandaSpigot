index 5fd93af71de1c39690c5335b94b9cb2b62af14d1..7657db2c3c8342b59ed756301360fc98010297d2 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -8,6 +8,7 @@ val adventureVersion = "4.25.0" // PandaSpigot - Adventure
 
 repositories {
     maven(url = "https://libraries.minecraft.net")
+    maven(url = "https://repo.papermc.io/repository/maven-public")
 }
 
 dependencies {
@@ -21,6 +22,11 @@ dependencies {
 
     // Minecraft libraries:
     implementation("io.netty:netty-all:4.1.132.Final") // PandaSpigot - Update Netty to 4.1.x
+    implementation("com.velocitypowered:velocity-native:1.1.5") {
+        exclude(group = "io.netty")
+        exclude(group = "com.google.guava")
+        exclude(group = "org.checkerframework")
+    } // PandaSpigot - native libdeflate compression
     implementation("com.mojang:authlib:1.5.21")
     // PandaSpigot start - Update log4j
     implementation("org.apache.logging.log4j:log4j-api:2.25.3")
